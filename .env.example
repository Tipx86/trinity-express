# Database Connection (SQLite for zero-config local dev, replace with PostgreSQL in production)
# PostgreSQL Example: postgresql://user:password@localhost:5432/trinity_express?schema=public
DATABASE_URL="file:./dev.db"

# Application URL & Authentication
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seat Reservation Hold Expiration (in minutes)
SEAT_HOLD_DURATION_MINUTES=10

# East African Payment Integrations (Sandbox / Live)
# M-Pesa / Safaricom Daraja API
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="your_mpesa_passkey"

# Airtel Money East Africa API
AIRTEL_MONEY_ENV="sandbox"
AIRTEL_CLIENT_ID="your_airtel_client_id"
AIRTEL_CLIENT_SECRET="your_airtel_client_secret"

# Card / Gateway (Visa, Mastercard, DPO Group / Pesapal)
PAYMENT_GATEWAY_PROVIDER="SANDBOX"
PAYMENT_GATEWAY_PUBLIC_KEY="pk_live_or_test_key"
PAYMENT_GATEWAY_SECRET_KEY="sk_live_or_test_key"

# Transactional Email Service (Resend or SMTP)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Trinity Express <bookings@trinityexpress.rw>"
